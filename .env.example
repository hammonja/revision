# Either set the key here, or reuse the Tools project .env file.
# A sibling ../tools/.env is discovered automatically. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_ENV_FILE=/home/pi/tools/.env

HOST=127.0.0.1
PORT=3000
# Set to 1 when the site is served over HTTPS (including a Cloudflare tunnel).
REVISION_SECURE_COOKIES=0
REVISION_AI_DAILY_LIMIT=10
REVISION_AI_SITE_DAILY_LIMIT=100
